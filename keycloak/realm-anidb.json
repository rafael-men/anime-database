{
  "realm": "anidb",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Acesso a moderação da aplicação" }
    ]
  },
  "defaultRoles": ["offline_access", "uma_authorization"],
  "clients": [
    {
      "clientId": "anime-admin",
      "name": "Anime Database Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "anime-admin-dev-secret-troque-em-producao",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/control/callback", "http://localhost:4000/*"],
      "webOrigins": ["http://localhost:4000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4000/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ]
}