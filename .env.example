# Variaveis usadas pelo docker compose.
# Copie para .env na raiz: cp .env.example .env

# ---------------------------------------------------------------------------
# Portas publicadas no host
# ---------------------------------------------------------------------------
CLIENT_PORT=4000
SERVER_PORT=3000

# ---------------------------------------------------------------------------
# MySQL (servico `db`)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=animelog
DB_USERNAME=animelog
DB_PASSWORD=animelog
# true cria/atualiza as tabelas automaticamente (TypeORM synchronize).
# Use false em producao e aplique migracoes manualmente.
DB_SYNC=true
DB_LOG=false

# ---------------------------------------------------------------------------
# Backend NestJS (servico `server`)
# ---------------------------------------------------------------------------
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
JWT_EXPIRATION=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Origens liberadas no CORS. Aponte para o dominio publico do frontend em producao.
FRONTEND_URLS=http://localhost:4000,http://127.0.0.1:4000

# local = avatares no volume `uploads-data`; s3 = AWS S3 ou compativel.
STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# Frontend Angular (servico `client`)
# ---------------------------------------------------------------------------
# URL absoluta da API, embutida no bundle durante o build (docker compose build).
# Em Docker local o navegador acessa o backend pela porta publicada no host.
API_BASE_URL=http://localhost:3000
# Origens extras para a diretiva CSP connect-src (separadas por espaco ou virgula).
CSP_CONNECT_SRC=